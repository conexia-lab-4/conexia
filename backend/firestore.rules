rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isParticipant(tripId) {
      return signedIn() && request.auth.uid in
        get(/databases/$(database)/documents/conversations/$(tripId)).data.participantIds;
    }

    // Una conversación por viaje (id = tripId). La crea y mantiene el backend
    // con Firebase Admin; el cliente solo actualiza el último mensaje
    match /conversations/{tripId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create, delete: if false;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastMessage', 'updatedAt'])
        && request.resource.data.lastMessage.authorId == request.auth.uid
        && request.resource.data.updatedAt == request.time;

      match /messages/{messageId} {
        allow read: if isParticipant(tripId);
        allow create: if isParticipant(tripId)
          && request.resource.data.keys().hasOnly(['text', 'authorId', 'sentAt'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.trim().size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.sentAt == request.time;
        allow update, delete: if false;
      }
    }

    // Todo lo demás queda cerrado para los clientes
    match /{document=**} {
      allow read, write: if false;
    }
  }
}