generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id
  email          String          @unique
  createdAt      DateTime        @default(now())
  studentProfile StudentProfile?
  subjects       Subject[]
  trips          Trip[]
  tripPassengers TripPassenger[]
  travelIntents  TravelIntent[]
}

model StudentProfile {
  id                     String    @id @default(uuid())
  userId                 String    @unique
  university             String?
  universityId           String?
  career                 String?
  year                   Int?
  campus                 String?
  campusId               String?
  hasCar                 Boolean?
  availableSeats         Int?
  questionnaireCompleted Boolean   @default(false)
  carModel               String?
  carColor               String?
  originAddress          String?
  phone                  String?
  birthDate              DateTime?
  bio                    String?
  detourToleranceKm      Int?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])
  universityRef University? @relation(fields: [universityId], references: [id])
  campusRef     Campus?     @relation(fields: [campusId], references: [id])
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum SubjectColor {
  BLUE
  PURPLE
  PINK
  ORANGE
  YELLOW
  GREEN
  RED
  CREAM
}

model Subject {
  id             String       @id @default(uuid())
  userId         String
  name           String
  color          SubjectColor @default(BLUE)
  visibleProfile Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user      User       @relation(fields: [userId], references: [id])
  schedules Schedule[]
}

model Schedule {
  id        String    @id @default(uuid())
  subjectId String
  dayOfWeek DayOfWeek
  startTime String
  endTime   String
  classroom String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

model Trip {
  id             String        @id @default(uuid())
  driverId       String
  origin         String
  originLat      Float?
  originLng      Float?
  destination    String
  destinationLat Float?
  destinationLng Float?
  departureTime  DateTime
  arrivalTime    DateTime
  capacity       Int
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  travelMatches  TravelMatch[]

  driver     User            @relation(fields: [driverId], references: [id])
  passengers TripPassenger[]
}

model TripPassenger {
  id        String   @id @default(uuid())
  tripId    String
  userId    String
  pickupAddress  String?
  pickupLat      Float?
  pickupLng      Float?
  dropoffAddress String?
  dropoffLat     Float?
  dropoffLng     Float?
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([tripId, userId])
}

enum TravelIntentStatus {
  ACTIVE
  FULFILLED
  CANCELLED
  EXPIRED
}

model TravelIntent {
  id             String             @id @default(uuid())
  userId         String
  origin         String
  originLat      Float
  originLng      Float
  destination    String
  destinationLat Float
  destinationLng Float
  departureTime  DateTime
  arrivalTime    DateTime
  status         TravelIntentStatus @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  travelMatches  TravelMatch[]

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([status, departureTime])
}

enum TravelMatchStatus {
  SUGGESTED
  ACCEPTED
  INVALIDATED
  REJECTED
}

model TravelMatch {
  id                    String            @id @default(uuid())
  tripId                String
  travelIntentId        String
  score                 Float
  detourKm              Float
  departureDeltaMinutes Float
  arrivalDeltaMinutes   Float
  algorithmVersion      String
  status                TravelMatchStatus @default(SUGGESTED)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  trip         Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  travelIntent TravelIntent @relation(fields: [travelIntentId], references: [id], onDelete: Cascade)

  @@unique([tripId, travelIntentId])
  @@index([travelIntentId])
}


model DailyMetric {
  date   DateTime @db.Date   // día en hora argentina
  metric String              // ej: "trips_published"
  value  Float

  @@id([date, metric])
}

model KpiEvent {
  id         String   @id @default(uuid())
  type       String   // TRIP_PUBLISHED, INTENT_PUBLISHED, MATCH_CREATED, MATCH_ACCEPTED, MATCH_REJECTED
  refId      String
  userId     String   // sin FK a User a propósito
  occurredAt DateTime @default(now())

  @@unique([type, refId, userId])
  @@index([type, occurredAt])
}

model University {
  id       String   @id
  name     String   @unique
  campuses Campus[]
  studentProfiles StudentProfile[]
}

model Campus {
  id           String @id
  universityId String
  name         String
  address      String
  latitude     Float
  longitude    Float
  studentProfiles StudentProfile[]

  university University @relation(fields: [universityId], references: [id])

  @@unique([universityId, name])
}