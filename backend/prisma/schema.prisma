generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id
  email          String          @unique
  createdAt      DateTime        @default(now())
  studentProfile StudentProfile?
  subjects       Subject[]
  trips          Trip[]
  tripPassengers TripPassenger[]
  travelIntents  TravelIntent[]
}

model StudentProfile {
  id                     String    @id @default(uuid())
  userId                 String    @unique
  university             String?
  career                 String?
  year                   Int?
  campus                 String?
  hasCar                 Boolean?
  availableSeats         Int?
  questionnaireCompleted Boolean   @default(false)
  carModel               String?
  carColor               String?
  originAddress          String?
  phone                  String?
  birthDate              DateTime?
  bio                    String?
  detourToleranceKm      Int?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum SubjectColor {
  BLUE
  PURPLE
  PINK
  ORANGE
  YELLOW
  GREEN
  RED
  CREAM
}

model Subject {
  id             String       @id @default(uuid())
  userId         String
  name           String
  color          SubjectColor @default(BLUE)
  visibleProfile Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user      User       @relation(fields: [userId], references: [id])
  schedules Schedule[]
}

model Schedule {
  id        String    @id @default(uuid())
  subjectId String
  dayOfWeek DayOfWeek
  startTime String
  endTime   String
  classroom String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

model Trip {
  id             String   @id @default(uuid())
  driverId       String
  origin         String
  originLat      Float?
  originLng      Float?
  destination    String
  destinationLat Float?
  destinationLng Float?
  departureTime  DateTime
  arrivalTime    DateTime
  capacity       Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  driver     User            @relation(fields: [driverId], references: [id])
  passengers TripPassenger[]
}

model TripPassenger {
  id        String   @id @default(uuid())
  tripId    String
  userId    String
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([tripId, userId])
}

enum TravelIntentStatus {
  ACTIVE
  FULFILLED
  CANCELLED
  EXPIRED
}

model TravelIntent {
  id             String             @id @default(uuid())
  userId         String
  origin         String
  originLat      Float
  originLng      Float
  destination    String
  destinationLat Float
  destinationLng Float
  departureTime  DateTime
  arrivalTime    DateTime
  status         TravelIntentStatus @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([status, departureTime])
}
